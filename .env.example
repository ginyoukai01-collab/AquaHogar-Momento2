# =========================
# Flask / seguridad
# =========================
SECRET_KEY=
FLASK_ENV=development
COOKIE_SECURE=false
APP_TIMEZONE=America/Bogota

# =========================
# PostgreSQL
# =========================
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/aquahogar

# =========================
# Integración IoT HTTP (compatibilidad)
# =========================
IOT_API_KEY=
AQUAHOGAR_API_URL=http://127.0.0.1:5000/api/iot/lecturas
SENSOR_CODE=ESP32-PRINCIPAL-01

# =========================
# MQTT / backend Flask
# =========================
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_USER=aquahogar_backend
MQTT_PASS=
MQTT_CLIENT_ID=aquahogar-backend
MQTT_KEEPALIVE=60
MQTT_SELF_TEST=false

# =========================
# MQTT / dispositivo o simulador
# No reutilizar la contraseña del backend.
# =========================
MQTT_DEVICE_USER=aquahogar_device
MQTT_DEVICE_PASS=
MQTT_HOUSEHOLD_ID=1
MQTT_SIMULATOR_CLIENT_ID=aquahogar-simulador-1
MQTT_SIMULATOR_INTERVAL_SECONDS=1
MQTT_SIMULATOR_STEP_MINUTES=10
MQTT_SIMULATOR_LEAK_ENABLED=false
MQTT_SIMULATOR_LEAK_START_HOUR=3
MQTT_SIMULATOR_LEAK_FLOW_L_MIN=2.0

# =========================
# Usuarios de evaluación / seed
# =========================
ADMIN_NAME=Administrador AquaHogar
ADMIN_EMAIL=admin@aquahogar.demo
ADMIN_PASSWORD=
DEMO_USER_NAME=Usuario AquaHogar
DEMO_USER_EMAIL=usuario@aquahogar.demo
DEMO_USER_PASSWORD=
